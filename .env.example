# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run in demo mode (sample data, nothing saved).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server-only, used by the couple's dashboard. Never share it or commit it.
SUPABASE_SECRET_KEY=sb_secret_...

# Google emails that can open /admin (comma-separated)
ADMIN_EMAILS=partner.a@gmail.com,partner.b@gmail.com

# Optional: your final URL, e.g. https://our-goa-wedding.com (used in calendar invites)
NEXT_PUBLIC_SITE_URL=

# Optional: any long random string; Vercel uses it to authenticate the daily keep-alive ping
CRON_SECRET=

# ── Photo Booth storage (ImageKit). See SETUP.md step 8. ──
# Leave empty to test the booth locally: photos are then kept in memory (lost on restart).
# ImageKit → Developer options → API keys. The private key is secret: never share or commit it.
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
# Optional: any long random string; signs upload tickets (defaults to the Supabase secret key)
BOOTH_SIGNING_SECRET=

# ── Photo Booth archive to Google Drive. See SETUP.md step 9. ──
# The same Google OAuth client as "Continue with Google" (step 3). The secret is a password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
